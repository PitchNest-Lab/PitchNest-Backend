{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node --max-old-space-size=384 ./node_modules/tsx/dist/cli.mjs server.ts",
    "dev": "tsx watch server.ts",
    "build": "echo 'Skipping Vite build for Express backend'",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npm run test:core && npm run test:organization-security && npm run test:business-security && npm run test:public-business && npm run test:discover-engagement && npm run test:session-security && npm run test:practice-bridge && npm run test:activity && npm run test:community && npm run test:opportunities && npm run test:analytics && npm run test:pitch && npm run test:ai-models && npm run test:speech && npm run test:business-media && npm run test:founders && npm run test:billing && npm run test:ws-admission && npm run test:aws",
    "test:core": "tsx src/tests/run_tests.ts",
    "test:organization-security": "tsx src/tests/organization_security_test.ts",
    "test:business-security": "tsx src/tests/business_security_test.ts",
    "test:public-business": "tsx src/tests/public_business_test.ts",
    "test:discover-engagement": "tsx src/tests/discover_engagement_test.ts",
    "test:session-security": "tsx src/tests/session_security_test.ts",
    "test:practice-bridge": "tsx src/tests/practice_bridge_test.ts",
    "test:activity": "tsx src/tests/activity_notifications_test.ts",
    "test:community": "tsx src/tests/community_test.ts",
    "test:opportunities": "tsx src/tests/opportunities_test.ts",
    "test:analytics": "tsx src/tests/analytics_test.ts",
    "test:pitch": "tsx src/tests/pitch_test.ts",
    "test:ai-models": "tsx src/tests/ai_models_test.ts",
    "test:speech": "tsx src/tests/speech_context_test.ts",
    "test:business-media": "tsx src/tests/business_media_test.ts",
    "test:founders": "tsx src/tests/founder_test.ts",
    "test:billing": "tsx src/tests/subscription_billing_test.ts",
    "test:ws-admission": "tsx src/tests/ws_admission_test.ts",
    "test:aws": "tsx --test src/tests/security/*.test.ts src/tests/config/*.test.ts src/tests/artifact/*.test.ts",
    "job:trial-lifecycle": "tsx src/jobs/runTrialLifecycle.ts",
    "build:lambda": "bash build-lambda.sh",
    "build:lambda:prod": "node scripts/build-lambda-prod.mjs",
    "verify:lambda:prod": "node scripts/verify-lambda-artifact.mjs",
    "migrations:combined": "node scripts/migrations/build-combined.mjs",
    "test:migrations": "node scripts/migrations/test-combined.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1147.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@supabase/supabase-js": "^2.106.2",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "microsoft-cognitiveservices-speech-sdk": "^1.52.0",
    "multer": "^2.4.0",
    "openai": "^6.42.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "resend": "^6.16.0",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "undici": "^7.30.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "qs": "6.16.1"
  }
}
