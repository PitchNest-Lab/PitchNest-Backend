# ── Supabase ──
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Auth ──
JWT_SECRET=your-strong-random-secret-here

# ── Internal admin (Item C: transcript review) ──
# Shared secret for the internal-only transcript endpoint (GET /api/admin/
# transcripts), sent as the `x-admin-key` request header. NOT a user role.
# Leave blank to DISABLE the admin routes entirely (they return 404).
ADMIN_API_KEY=

# ── Google Sign-In (optional — enables "Continue with Google") ──
# OAuth 2.0 Web client id from Google Cloud Console. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=

# ── CORS (comma-separate multiple origins in production) ──
ALLOWED_ORIGIN=http://localhost:5174
# Extra allowed origins beyond the built-in defaults (comma-separated). Lets you
# add a new deploy/preview domain without a code change.
CORS_EXTRA_ORIGINS=

# ── Storage ──
# Supabase Storage bucket for PRIVATE media (decks, pitch videos). Read via
# short-lived signed URLs. Flip this bucket to Private (see migration 0006).
SUPABASE_STORAGE_BUCKET=pitchnest-media

# Separate PUBLIC bucket for avatars (low-sensitivity, rendered unsigned). Keep
# this bucket Public so profile pictures load without signing.
SUPABASE_AVATAR_BUCKET=pitchnest-avatars

# ── Azure OpenAI (text generation — required for live pitch) ──
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ── Azure Speech (TTS — required for panel voices) ──
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# ── Mail (SMTP — verification & password-reset emails) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
CLIENT_URL=http://localhost:5174
# Verified sender identity for transactional email (Resend).
# Must be an address on a domain verified in Resend — a gmail.com sender is
# rejected with 403 "domain is not verified".
EMAIL_FROM=PitchNest <hello@pitchnest.app>
# Where user replies are routed. Free to be any mailbox, verified or not.
EMAIL_REPLY_TO=pitchnestapp@gmail.com

# ── Optional fallback (if not using Azure OpenAI) ──
OPENAI_API_KEY=

# ── Legacy Gemini (only needed if re-enabling liveSocket.ts) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# ── Server ──
PORT=3000
NODE_ENV=development

# ── Billing: Flutterwave v3 Standard (hosted checkout) ──
# The v3 SECRET key (FLWSECK-...) and PUBLIC key (FLWPUBK-...) from your
# Flutterwave dashboard → Settings → API Keys.
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
# REQUIRED for billing to turn on. Dashboard → Settings → Webhooks → "Secret hash".
# Must match exactly; without it, checkout is disabled (503) so no grant can be
# made that we couldn't verify.
FLW_WEBHOOK_HASH=
# Pro price. Amount is in MAJOR units (10 = $10.00). Change without a code deploy.
PRO_PLAN_AMOUNT=10
PRO_PLAN_CURRENCY=USD
PRO_PLAN_DAYS=30
# Public base URL Flutterwave redirects back to after checkout (no trailing slash).
# e.g. https://www.pitchnest.app  — falls back to ALLOWED_ORIGIN if unset.
APP_BASE_URL=
