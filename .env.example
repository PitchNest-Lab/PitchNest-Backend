# ── Server Configuration ──
PORT=3000
NODE_ENV=production

# ── Supabase (Database & Storage) ──
# From your new Supabase Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Buckets (preconfigured in setup script)
SUPABASE_STORAGE_BUCKET=pitchnest-media
SUPABASE_AVATAR_BUCKET=pitchnest-avatars

# ── Authentication ──
# Generate a random 64-char string (e.g. openssl rand -hex 32)
JWT_SECRET=your-secure-random-jwt-secret
GOOGLE_CLIENT_ID=

# ── CORS & App URLs ──
# Your frontend's address on Cloudflare Pages (or its custom domain), with no
# trailing slash. Browsers may call the API only from origins listed here;
# wildcards such as * are not accepted.
ALLOWED_ORIGIN=https://your-project.pages.dev
# Extra browser origins, comma-separated: a custom domain or a preview build.
# localhost is allowed automatically when NODE_ENV is not production.
CORS_EXTRA_ORIGINS=
# Where verification emails, trial emails and payment redirects send people.
# Usually the same address as ALLOWED_ORIGIN.
APP_BASE_URL=https://your-project.pages.dev
CLIENT_URL=https://your-project.pages.dev

# ── AI Evaluator (Azure OpenAI or OpenAI) ──
AZURE_OPENAI_ENDPOINT=https://pitchnestbrain.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2026-07-09

# ── AI model tiers (src/config/aiModels.ts) ──
# Optional stronger model for Pro coaching. Until it is set, Pro uses the
# deployment above. Scoring always uses the standard model on every plan.
AZURE_OPENAI_DEPLOYMENT_ADVANCED=
# Optional reasoning effort per model: minimal | low | medium | high.
# Leave empty to use the model's own default.
AI_ADVANCED_REASONING_EFFORT=
AI_STANDARD_REASONING_EFFORT=
# Only if the advanced model lives in a different Azure resource.
AZURE_OPENAI_ENDPOINT_ADVANCED=
AZURE_OPENAI_API_KEY_ADVANCED=

# ── Voice & Audio (Azure Speech SDK) ──
AZURE_SPEECH_KEY=your-azure-speech-key
# Must be a region that serves the recognition locale below. African English
# locales (en-NG, en-KE, en-GH, en-ZA, en-TZ) are not available in every region —
# if voice sessions fail to recognise, check this first.
AZURE_SPEECH_REGION=eastus
# Fallback recognition language for users who have not chosen one in
# Settings → Voice & Language. en-NG is the Africa-first default; users can pick
# their own per-account. Setting this to an unsupported value is safe — it
# degrades to en-NG rather than breaking recognition.
STT_DEFAULT_LOCALE=en-NG

# ── Email Service (Verification & Passwords) ──
RESEND_API_KEY=re_xxxxxxxxx
# onboarding@resend.dev is for initial testing. Use an address on your verified
# Resend domain before sending verification emails to real users.
EMAIL_FROM="PitchNest <onboarding@resend.dev>"
EMAIL_REPLY_TO=you@example.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ── Admin & Billing (Optional) ──
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_HASH=

# ── Ecosystem: Discover ──
# Canonical public site origin used in sitemaps, canonical URLs and link
# previews. Falls back to CLIENT_URL.
PUBLIC_SITE_URL=https://your-project.pages.dev
# Supports, follows, comments and reports on public business profiles.
# Defaults to on in development and OFF in production. Turn it on only after
# migration 0021 is applied and a moderator has users.is_staff = TRUE.
FEATURE_DISCOVER_ENGAGEMENT=false
# Community discussions at /community. Same default as above. Turn it on only
# after migration 0023 is applied and moderators are ready.
FEATURE_COMMUNITY=false
# Pitch Arena at /pitches: founder-written public pitches with structured
# feedback. Same default. Turn it on only after migration 0026 is applied and
# FEATURE_DISCOVER_ENGAGEMENT is on (feedback is posted as profile comments).
FEATURE_PITCH_ARENA=false
